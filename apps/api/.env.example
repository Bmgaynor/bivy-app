# Copy to apps/api/.env.local (git-ignored) for `nx serve api`.
# In production these are set on the container by the homelab Pulumi stack.

# The exact URL configured as the Twilio number's webhook, e.g. your ngrok URL + /sms
WEBHOOK_URL=https://example.ngrok-free.app/sms
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 numbers allowed to get replies
ALLOWED_NUMBERS=
# Optional
# PORT=8787
# WEATHER_PROVIDER=open-meteo
